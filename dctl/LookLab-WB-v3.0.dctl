__DEVICE__ float3 apply_tint_preset(float3 rgb,int tint_id){
  if(tint_id<=0)return rgb;
  // V2: correction direction fixed.
  // Green Fix applies compensating magenta; Magenta Fix applies compensating green.
  if(tint_id==1)return mmul(make_float3(1.00403773f,-0.00107492f,0.00016121464f),make_float3(0.00742283926f,0.997121286f,-0.000541873696f),make_float3(8.39434552e-05f,0.0021552227f,1.01701071f),rgb);
  if(tint_id==2)return mmul(make_float3(1.00806728f,-0.00214502622f,0.000329458746f),make_float3(0.0148171869f,0.994258475f,-0.00109344549f),make_float3(0.000203219791f,0.00435844107f,1.03449807f),rgb);
  if(tint_id==3)return mmul(make_float3(1.01342745f,-0.00356436854f,0.000565221093f),make_float3(0.0246324546f,0.990465693f,-0.00184475149f),make_float3(0.000419516402f,0.00737448075f,1.05859133f),rgb);
  if(tint_id==4)return mmul(make_float3(0.995954009f,0.00107974935f,-0.000154458484f),make_float3(-0.00745160345f,1.00289487f,0.000532606905f),make_float3(-4.98609853e-05f,-0.00210927347f,0.983446673f),rgb);
  if(tint_id==5)return mmul(make_float3(0.991899671f,0.00216434573f,-0.000302419877f),make_float3(-0.0149322508f,1.00580616f,0.00105635753f),make_float3(-6.68204696e-05f,-0.00417453828f,0.967332494f),rgb);
  if(tint_id==6)return mmul(make_float3(0.986480756f,0.00361804883f,-0.000490016132f),make_float3(-0.0249521219f,1.00971385f,0.00174158308f),make_float3(-4.01734191e-05f,-0.00686293281f,0.946500306f),rgb);
  return rgb;
}

// ---------------- Main ----------------
__DEVICE__ float3 transform(int p_Width,int p_Height,int p_X,int p_Y,float p_R,float p_G,float p_B){
  // Resolve-safe combo reads: round to nearest option index.
  int src=clampi((int)(wb_source+0.5f),0,24);
  int tgt=clampi((int)(wb_target+0.5f),0,5);
  int tint=clampi((int)(tint_preset+0.5f),0,6);

  // Exact neutral bypass: source selection alone does not alter the image.
  if(tgt==0 && tint==0)
    return make_float3(p_R,p_G,p_B);

  float3 lin=lc3_decode(make_float3(p_R,p_G,p_B));

  if(tgt!=0)
    lin=apply_wb_preset(lin,src,tgt);

  if(tint!=0)
    lin=apply_tint_preset(lin,tint);

  return lc3_encode(lin);
}
