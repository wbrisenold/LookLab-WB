// LookLab-WB-v3.0.dctl
// LookLab WB-only rebuild.
//
// INPUT : ARRI Wide Gamut 3 / LogC3 EI800
// OUTPUT: ARRI Wide Gamut 3 / LogC3 EI800
//
// INTENDED NODE ORDER:
// CST -> LookLab WB -> PD LogC3 FilmMatrix -> LensNode -> Keystone -> ODT
//
// v3.0 removes all Start presets, creative looks, FilmMatrix precompensation,
// Matrix Fix, Technical Safety, strength controls, and shared creative finishing.
// It retains only the established WB Source -> Target matrices and Tint fixes
// from LookLab-Presets-v2.1.
//
// Neutral state is an exact bypass:
// WB Target Off + Tint Off returns the input code values unchanged.
//
// SPDX-License-Identifier: MIT

// ---------------- WHITE BALANCE ----------------
DEFINE_UI_PARAMS(wb_source, WB / Source, DCTLUI_COMBO_BOX, 16, {WB_SRC_2200, WB_SRC_2400, WB_SRC_2600, WB_SRC_2800, WB_SRC_3000, WB_SRC_3200, WB_SRC_3400, WB_SRC_3600, WB_SRC_3800, WB_SRC_4000, WB_SRC_4300, WB_SRC_4500, WB_SRC_4800, WB_SRC_5000, WB_SRC_5200, WB_SRC_5500, WB_SRC_5600, WB_SRC_6000, WB_SRC_6500, WB_SRC_7000, WB_SRC_7500, WB_SRC_8000, WB_SRC_8500, WB_SRC_9000, WB_SRC_10000}, {2200K, 2400K, 2600K, 2800K, 3000K, 3200K, 3400K, 3600K, 3800K, 4000K, 4300K, 4500K, 4800K, 5000K, 5200K, 5500K, 5600K, 6000K, 6500K, 7000K, 7500K, 8000K, 8500K, 9000K, 10000K})
DEFINE_UI_PARAMS(wb_target, WB / Target, DCTLUI_COMBO_BOX, 0, {WB_TARGET_OFF, WB_TARGET_3200, WB_TARGET_4300, WB_TARGET_5500, WB_TARGET_5600, WB_TARGET_6500}, {Off, 3200K Tungsten, 4300K Mixed, 5500K 50D-250D, 5600K Daylight, 6500K D65})
DEFINE_UI_PARAMS(tint_preset, Tint / Preset, DCTLUI_COMBO_BOX, 0, {TINT_OFF, TINT_GREEN_LOW, TINT_GREEN_MED, TINT_GREEN_HIGH, TINT_MAGENTA_LOW, TINT_MAGENTA_MED, TINT_MAGENTA_HIGH}, {Off, Green Fix Low, Green Fix Med, Green Fix High, Magenta Fix Low, Magenta Fix Med, Magenta Fix High})

// ---------------- LogC3 EI800 ----------------
#define LOGC3_CUT 0.010591f
#define LOGC3_A 5.555556f
#define LOGC3_B 0.052272f
#define LOGC3_C 0.247190f
#define LOGC3_D 0.385537f
#define LOGC3_E 5.367655f
#define LOGC3_F 0.092809f
#define LOGC3_CODE_CUT 0.149657834105f

// ---------------- Helpers ----------------
__DEVICE__ int clampi(int x,int a,int b){return x<a?a:(x>b?b:x);}

__DEVICE__ float3 mmul(float3 c0,float3 c1,float3 c2,float3 v){
  return make_float3(
    c0.x*v.x+c1.x*v.y+c2.x*v.z,
    c0.y*v.x+c1.y*v.y+c2.y*v.z,
    c0.z*v.x+c1.z*v.y+c2.z*v.z);
}

__DEVICE__ float lc3_dec_1(float v){
  if(v>LOGC3_CODE_CUT)
    return (_powf(10.0f,(v-LOGC3_D)/LOGC3_C)-LOGC3_B)/LOGC3_A;
  return (v-LOGC3_F)/LOGC3_E;
}

__DEVICE__ float lc3_enc_1(float x){
  if(x>LOGC3_CUT){
    float a=_fmaxf(LOGC3_A*x+LOGC3_B,1.0e-30f);
    return LOGC3_C*_log10f(a)+LOGC3_D;
  }
  return LOGC3_E*x+LOGC3_F;
}

__DEVICE__ float3 lc3_decode(float3 v){
  return make_float3(lc3_dec_1(v.x),lc3_dec_1(v.y),lc3_dec_1(v.z));
}

__DEVICE__ float3 lc3_encode(float3 v){
  return make_float3(lc3_enc_1(v.x),lc3_enc_1(v.y),lc3_enc_1(v.z));
}

// ---------------- WB / Tint matrices ----------------
__DEVICE__ float3 apply_wb_preset(float3 rgb,int source_id,int target_id){
  if(target_id<=0)return rgb;
  if(target_id==1){
